digraph G { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.35",ranksep="0.35",label="Order state and external uncertainty",labelloc=t,fontname="DejaVu Sans",fontsize=18]; node [shape=box,style="rounded,filled",fillcolor="#f1f5f9",color="#64748b",fontname="DejaVu Sans",fontsize=11,margin="0.14,0.10"]; edge [color="#64748b",fontname="DejaVu Sans",fontsize=9]; reserved [label="RESERVED"]; submitting [label="SUBMITTING"]; unknown [label="UNKNOWN\nretain reservation / NO RESEND",fillcolor="#fee2e2"]; pending [label="ACCEPTED_PENDING"]; partial [label="PARTIALLY_FILLED"]; filled [label="FILLED"]; reject [label="REJECTED"]; cancel [label="CANCELED / EXPIRED"]; reserved -> submitting; reserved -> unknown [label="restart uncertainty"]; submitting -> unknown [label="exception / uncertainty"]; submitting -> pending; submitting -> partial; submitting -> filled; submitting -> reject; unknown -> pending [label="native reconcile"]; unknown -> partial; unknown -> filled; unknown -> reject; unknown -> cancel; pending -> partial; pending -> filled; pending -> cancel [label="native observation / separate cancel"]; pending -> unknown; partial -> filled; partial -> cancel; partial -> unknown; }
