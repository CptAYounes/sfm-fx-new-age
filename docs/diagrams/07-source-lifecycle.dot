digraph G { graph [rankdir=TB,bgcolor="white",pad="0.3",nodesep="0.35",ranksep="0.35",label="Source authority lifecycle",labelloc=t,fontname="DejaVu Sans",fontsize=18]; node [shape=box,style="rounded,filled",fillcolor="#f1f5f9",color="#64748b",fontname="DejaVu Sans",fontsize=11,margin="0.14,0.10"]; edge [color="#64748b",fontname="DejaVu Sans",fontsize=9]; empty [label="No current source"]; auth [label="Authenticated exact account"]; meta [label="Current native pair metadata\nID / spec / schedule / epoch"]; inputs [label="Fresh matching observations\ncomplete declared input window"]; current [label="Eligible current analytical output"]; withdraw [label="Withdraw authority / reject late results",fillcolor="#fee2e2"]; saved [label="Persisted history only\nnot restored authority"]; empty -> auth -> meta -> inputs -> current; auth -> withdraw [label="disconnect / revoked grant"]; meta -> withdraw [label="pair withdrawal / new epoch"]; inputs -> withdraw [label="expiry / invalid payload / gap"]; current -> withdraw [label="source/profile/switch change"]; withdraw -> saved; withdraw -> auth [label="explicit current recovery"]; saved -> saved [label="inspection only"]; }
