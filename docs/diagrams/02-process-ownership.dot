digraph G { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.35",ranksep="0.35",label="Process and storage boundaries",labelloc=t,fontname="DejaVu Sans",fontsize=18]; node [shape=box,style="rounded,filled",fillcolor="#f1f5f9",color="#64748b",fontname="DejaVu Sans",fontsize=11,margin="0.14,0.10"]; edge [color="#64748b",fontname="DejaVu Sans",fontsize=9]; gui [label="Qt + ApplicationRuntime\nowner thread / admission / persistence",fillcolor="#c7e8dc"]; sdk [label="SDK child processes\nTLS / native protocol"]; auth [label="OAuth callback/auth worker"]; feed [label="Owned public-source workers"]; cpu [label="Pure projection processes\nno DB / GUI / secrets / broker"]; db [shape=cylinder,label="SQLite WAL / FULL\nrecords + orders + events"]; private [shape=folder,label="Private credential file\n0700 directory / 0600 plaintext"]; gui -> sdk [label="bounded commands"]; sdk -> gui [label="bounded events"]; auth -> gui [label="generation-bound result"]; feed -> gui [label="validated source binding"]; gui -> cpu [label="immutable job snapshots"]; cpu -> gui [label="token-bound pure results"]; gui -> db [label="owner transactions"]; auth -> private [label="atomic token persistence"]; }
