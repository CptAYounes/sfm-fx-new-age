digraph G { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.35",ranksep="0.35",label="Physical schema and logical associations",labelloc=t,fontname="DejaVu Sans",fontsize=18]; node [shape=box,style="rounded,filled",fillcolor="#f1f5f9",color="#64748b",fontname="DejaVu Sans",fontsize=11,margin="0.14,0.10"]; edge [color="#64748b",fontname="DejaVu Sans",fontsize=9]; records [shape=record,label="records|kind + id (PK)|body JSON"]; orders [shape=record,label="orders|id (PK)|scope_id + signal_id (UNIQUE)|account_id / body JSON"]; events [shape=record,label="events|sequence (PK)|event_id (UNIQUE)|topic / body JSON"]; bars [label="Scoped bar revisions"]; evidence [label="Research / supplemental revisions"]; pointers [label="Current projection / signal pointers"]; local [label="Local signal revisions"]; native [label="Native broker IDs / observed positions"]; records -> bars [style=dashed,label="logical JSON kinds"]; records -> evidence [style=dashed]; records -> pointers [style=dashed]; records -> local [style=dashed]; orders -> local [style=dashed,label="logical reference; not SQL FK"]; orders -> native [style=dashed,label="observed correlation"]; events -> records [style=dashed,label="journal context; no replay Issue"]; }
