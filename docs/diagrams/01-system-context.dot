digraph G { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.35",ranksep="0.35",label="System context \u2014 data and deliberate action",labelloc=t,fontname="DejaVu Sans",fontsize=18]; node [shape=box,style="rounded,filled",fillcolor="#f1f5f9",color="#64748b",fontname="DejaVu Sans",fontsize=11,margin="0.14,0.10"]; edge [color="#64748b",fontname="DejaVu Sans",fontsize=9]; operator [label="Human operator\nselect / review / bind / Issue",fillcolor="#dbeafe"]; app [label="SFM FX New Age\nlocal desktop + shared runtime",fillcolor="#c7e8dc"]; oauth [label="Browser / cTrader authorization"]; broker [label="Selected cTrader broker\naccount + market + native order state"]; kraken [label="Kraken public venue\nexecutions / quantities / checksum L2"]; bitstamp [label="Bitstamp public orders\nEURUSD / GBPUSD"]; official [label="CFTC / Board\ndeclared published context"]; files [label="Explicit local publisher\nscoped hash-checked JSON"]; operator -> app [label="human choices"]; app -> oauth [label="grant flow"]; broker -> app [label="observed facts"]; app -> broker [label="Issue / separate cancel ONLY",color="#b91c1c",fontcolor="#b91c1c"]; kraken -> app [label="venue context"]; bitstamp -> app [label="public displayed book"]; official -> app [label="bounded context"]; files -> app [label="explicit input admission"]; }
